{
  "name": "cvm-l402",
  "version": "0.0.1",
  "private": true,
  "description": "L402 (Lightning HTTP 402) payment rail for ContextVM CEP-8",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent node --import tsx --test 'src/**/*.test.ts'",
    "hello:server": "tsx src/examples/hello-server.ts",
    "hello:client": "tsx src/examples/hello-client.ts",
    "demo:l402": "tsx scripts/l402-demo.ts",
    "demo:cep8": "LOG_LEVEL=silent tsx scripts/cep8-demo.ts",
    "test:cep8": "LOG_LEVEL=silent node --import tsx --test src/cep8/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@contextvm/mcp-sdk": "^1.30.0",
    "@contextvm/sdk": "^0.14.0",
    "@noble/hashes": "^2.4.0",
    "nostr-tools": "^2.25.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
